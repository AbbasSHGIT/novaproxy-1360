{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaproxy-1360",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "29899fc1-205f-4f23-b9f5-fa9299ff538d","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "cba33bee29ad45269a2027d5c7b8cd1d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
